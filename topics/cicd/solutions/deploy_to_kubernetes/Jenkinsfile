// Требуются Docker Pipeline plugin, registry credentials dockerhub и настроенный агент.
pipeline {
  agent any
  environment {
    IMAGE_REPO = '<YOUR_DOCKER_USERNAME>/helloworld'
  }
  parameters {
    string(name: 'INGRESS_CLASS', defaultValue: '', description: 'Installed maintained IngressClass')
    string(name: 'TLS_CERT_FILE', defaultValue: '', description: 'Certificate path on the agent')
    string(name: 'TLS_KEY_FILE', defaultValue: '', description: 'Private key path on the agent')
  }
  stages {
    stage('Checkout Source') {
      steps {
        git url: 'https://github.com/<GITHUB_USERNAME>/<YOUR_WEB_APP_REPO>.git', branch: 'master'
      }
    }
    stage('Build and push') {
      steps {
        script {
          def image = docker.build("${env.IMAGE_REPO}:${env.BUILD_NUMBER}")
          docker.withRegistry('https://registry.hub.docker.com', 'dockerhub') {
            image.push()
          }
        }
      }
    }
    stage('Deploy App') {
      steps {
        script {
          writeFile file: 'deploy-vars.json', text: groovy.json.JsonOutput.toJson([
            app_image: "${env.IMAGE_REPO}:${env.BUILD_NUMBER}",
            ingress_class: params.INGRESS_CLASS,
            tls_cert_file: params.TLS_CERT_FILE,
            tls_key_file: params.TLS_KEY_FILE
          ])
        }
        sh 'ansible-playbook deploy.yml -e @deploy-vars.json'
      }
    }
  }
}
